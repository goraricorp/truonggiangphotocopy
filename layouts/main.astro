---
import "@/styles/global.css"
import Navbar from "@/components/custom/navbar"
import Footer from "@/components/custom/footer"
import NavigationProgress from "@/components/custom/navigation-progress"
import { ClientRouter } from "astro:transitions"
import { appGlobal } from "@/utils/constant"

const { title } = Astro.props
const pageTitle = title?.trim()
const documentTitle =
  Astro.url.pathname === "/" || !pageTitle
    ? appGlobal.name
    : `${pageTitle} | ${appGlobal.name}`
---

<html lang="vi" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <ClientRouter fallback="swap" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{documentTitle}</title>
    <script is:inline>
      ;(() => {
        if (window.__photocopyThemeInitialized) return
        window.__photocopyThemeInitialized = true
        const themes = ["system", "light", "dark"]
        const saved = document.cookie
          .split(";")
          .map((value) => value.trim())
          .find((value) => value.startsWith("color-theme="))
          ?.slice("color-theme=".length)
        let theme = themes.includes(saved) ? saved : "system"
        const media = window.matchMedia("(prefers-color-scheme: dark)")

        function applyTheme(root = document.documentElement) {
          const dark = theme === "dark" || (theme === "system" && media.matches)
          root.classList.toggle("dark", dark)
          root.dataset.theme = theme
          root.style.colorScheme = dark ? "dark" : "light"
          if (root === document.documentElement)
            window.dispatchEvent(new Event("color-theme-updated"))
        }

        window.addEventListener("color-theme-change", (event) => {
          if (!themes.includes(event.detail)) return
          theme = event.detail
          document.cookie = `color-theme=${theme}; Path=/; Max-Age=31536000; SameSite=Lax${location.protocol === "https:" ? "; Secure" : ""}`
          applyTheme()
        })
        media.addEventListener("change", () => {
          if (theme === "system") applyTheme()
        })
        document.addEventListener("astro:before-swap", (event) => {
          applyTheme(event.newDocument.documentElement)
        })
        document.addEventListener("astro:after-swap", () => applyTheme())
        applyTheme()
      })()
    </script>
  </head>
  <body class="flex min-h-svh flex-col">
    <NavigationProgress client:load transition:persist="navigation-progress" />
    <Navbar
      pathname={Astro.url.pathname}
      client:load
      transition:persist="navbar"
    />
    <main class="flex flex-1 flex-col">
      <div class="container mx-auto flex-1 p-6">
        <div class="w-full overflow-hidden">
          <slot />
        </div>
      </div>
    </main>
    <Footer />
  </body>
</html>
