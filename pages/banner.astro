---
import Layout from "@/layouts/main.astro"
import ButtonLink from "@/components/custom/button-link"
---

<Layout title="Biểu ngữ">
  <main class="flex min-h-svh p-6">
    <div class="flex max-w-md min-w-0 flex-col items-start gap-4 text-sm leading-loose">
      <h1 class="text-2xl font-semibold">Biểu ngữ</h1>
      <p class="text-muted-foreground">Chào mừng bạn đến với trang biểu ngữ.</p>
      <ButtonLink href="/" variant="outline">
        Về trang chủ
      </ButtonLink>
    </div>
  </main>
</Layout>
